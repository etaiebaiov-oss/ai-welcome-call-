<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title><%= call.homeowner_name %> · <%= companyName %></title>
</head>
<body>
  <%- include('partials/adminnav') %>

  <main class="wide">
    <% const fmtDate = (s) => {
      if (!s) return '—';
      try {
        const d = new Date(String(s).replace(' ', 'T') + 'Z');
        if (isNaN(d)) return s;
        return d.toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })
          + ' · ' + d.toLocaleString('en-US', { hour: 'numeric', minute: '2-digit', timeZone: 'UTC' });
      } catch (e) { return s; }
    }; %>
    <div style="display:flex;justify-content:space-between;align-items:center;gap:12px">
      <a class="muted" href="/admin">← Back to dashboard</a>
      <form method="post" action="/admin/calls/<%= call.id %>/delete" class="inline-form">
        <button class="btn btn-sm btn-ghost danger" type="submit" onclick="return confirm('Permanently delete this call record<%= call.recording_file ? ' AND its recording' : '' %>? This cannot be undone.')"><%- include('partials/icon', { name: 'trash', size: 14 }) %> Delete record</button>
      </form>
    </div>
    <% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %>

    <div class="card">
      <div class="detail-header">
        <h1><%= call.homeowner_name %></h1>
        <% if (call.status === 'completed') { %>
          <span class="badge badge-success"><%- include('partials/icon', { name: 'check', size: 12 }) %> Completed</span>
        <% } else if (call.status === 'flagged') { %>
          <span class="badge badge-warn"><%- include('partials/icon', { name: 'alert', size: 12 }) %> Flagged</span>
        <% } else if (call.status === 'in_progress') { %>
          <span class="badge badge-info"><%- include('partials/icon', { name: 'phone', size: 12 }) %> In progress</span>
        <% } else { %>
          <span class="badge badge-neutral"><%- include('partials/icon', { name: 'clock', size: 12 }) %> Pending</span>
        <% } %>
      </div>

      <div class="detail-grid">
        <div><span class="muted">Phone</span><br><%= call.phone %></div>
        <div><span class="muted">Email</span><br><%= call.email || '—' %></div>
        <div><span class="muted">Property address</span><br><%= call.property_address %></div>
        <div><span class="muted">Installer</span><br><%= call.installer || '—' %></div>
        <div><span class="muted">Monthly payment</span><br><%= call.monthly_payment || '—' %></div>
        <div><span class="muted">Rate escalator</span><br><%= call.escalator || '—' %></div>
        <div><span class="muted">Energy offset</span><br><%= call.offset_percent || '—' %></div>
        <div><span class="muted">Created</span><br><%= fmtDate(call.created_at) %> <span style="color:var(--faint);font-size:0.86em">· by <%= call.created_by %></span></div>
        <div><span class="muted">Completed</span><br><%= fmtDate(call.completed_at) %></div>
        <% if (call.duration_seconds) { %><div><span class="muted">Duration</span><br><%= Math.round(call.duration_seconds / 60) %> min <%= Math.round(call.duration_seconds % 60) %> sec</div><% } %>
        <% if (call.ended_reason) { %><div><span class="muted">Ended reason</span><br><code><%= call.ended_reason %></code></div><% } %>
      </div>

      <% if (call.terms) { %>
        <h3>Agreement details verified on this call</h3>
        <pre class="pre-box"><%= call.terms %></pre>
      <% } %>

      <% if (deal) { %>
        <h3>Deal details (from import)</h3>
        <% if (changeOrder) { %>
          <div class="alert alert-warn"><%- include('partials/icon', { name: 'alert', size: 16 }) %><div><strong>Change order / resign:</strong> <%= deal.change_order %></div></div>
        <% } %>
        <div class="detail-grid">
          <div><span class="muted">Stage</span><br><%= deal.stage || '—' %></div>
          <div><span class="muted">NTP status</span><br><%= deal.ntp_status || '—' %></div>
          <div><span class="muted">Finance</span><br><%= deal.finance_type || '—' %></div>
          <div><span class="muted">Panels</span><br><%= deal.panels || '—' %></div>
          <div><span class="muted">Current usage (kWh)</span><br><%= deal.current_usage_kwh || '—' %></div>
          <div><span class="muted">Sold production (kWh)</span><br><%= deal.sold_production_kwh || '—' %></div>
          <div><span class="muted">Site survey</span><br><%= deal.site_survey || '—' %></div>
          <div><span class="muted">Date submitted</span><br><%= deal.date_submitted || '—' %></div>
          <% if (deal.rep) { %><div><span class="muted">Rep</span><br><%= deal.rep %></div><% } %>
        </div>
        <% if (deal.notes) { %><p class="muted" style="margin-top:10px">Notes: <%= deal.notes %></p><% } %>
      <% } %>

      <% if (['pending', 'in_progress'].includes(call.status)) { %>
        <h3>Do the call</h3>
        <p><a class="btn" href="/admin/calls/<%= call.id %>/script"><%- include('partials/icon', { name: 'printer', size: 15 }) %> Manual call script (for a human caller)</a></p>
        <h3>Share link</h3>
        <div class="share-row">
          <input class="share-input" readonly value="<%= appUrl %>/call/<%= call.token %>" onclick="this.select()">
          <button class="btn btn-sm" onclick="navigator.clipboard.writeText('<%= appUrl %>/call/<%= call.token %>');this.textContent='Copied!'">Copy</button>
        </div>
        <% if (phoneCallsEnabled) { %>
          <form method="post" action="/admin/calls/<%= call.id %>/dial" style="margin-top:12px">
            <div class="btn-row" style="align-items:stretch">
              <input name="override_number" placeholder="Different number (optional — e.g. your own, to preview)" style="flex:1;min-width:240px">
              <button class="btn btn-primary" type="submit" onclick="return confirm('The AI will place this call now. Continue?')"><%- include('partials/icon', { name: 'phone-outgoing', size: 15 }) %> Have the AI call</button>
            </div>
            <p class="fineprint">Leave the box empty to call the number on file (<%= call.phone %>). Enter a different number to call that instead — the AI still uses this homeowner's script and details.</p>
          </form>
        <% } %>
      <% } %>
    </div>

    <% if (flags.length) { %>
      <div class="card flag-card">
        <h2 style="display:flex;align-items:center;gap:8px"><%- include('partials/icon', { name: 'alert', size: 18 }) %> Flagged for review</h2>
        <ul class="flag-list">
          <% flags.forEach((f) => { %><li><%- include('partials/icon', { name: 'alert', size: 14 }) %><span><%= f %></span></li><% }) %>
        </ul>
      </div>
    <% } %>

    <% if (call.recording_file || call.vapi_call_id) { %>
      <div class="card">
        <h2 style="display:flex;align-items:center;gap:8px"><%- include('partials/icon', { name: 'audio', size: 18 }) %> Recording <span class="muted" style="font-weight:normal;font-size:0.8em">(admin-only)</span></h2>
        <% if (call.recording_file) { %>
          <audio controls preload="none" src="/admin/calls/<%= call.id %>/recording" style="width:100%"></audio>
          <p><a class="btn" href="/admin/calls/<%= call.id %>/recording?download=1"><%- include('partials/icon', { name: 'download', size: 15 }) %> Download recording</a></p>
        <% } else { %>
          <p class="muted">This call's audio hasn't been saved to your server yet. Vapi's own links expire, so retrieve it here to keep a permanent copy.</p>
          <form method="post" action="/admin/calls/<%= call.id %>/fetch-recording" class="inline-form">
            <button class="btn btn-primary" type="submit"><%- include('partials/icon', { name: 'download', size: 15 }) %> Retrieve recording from Vapi</button>
          </form>
        <% } %>
      </div>
    <% } %>

    <% if (call.summary) { %>
      <div class="card">
        <h2>Call summary</h2>
        <p><%= call.summary %></p>
      </div>
    <% } %>

    <% if (analysis) { %>
      <div class="card">
        <h2>Verification checklist</h2>
        <div class="check-grid">
          <% const CHECKS = [
            ['Recording consent', analysis.consented_to_recording],
            ['Identity confirmed', analysis.confirmed_identity],
            ['Address confirmed', analysis.confirmed_address],
            ['Terms confirmed', analysis.confirmed_terms],
            ['Call completed', analysis.call_completed],
            ['Understood everything', analysis.understood_everything],
          ]; %>
          <% CHECKS.forEach(([label, ok]) => { %>
            <div>
              <span style="color:var(--<%= ok ? 'success' : 'danger' %>);display:inline-flex"><%- include('partials/icon', { name: ok ? 'check-circle' : 'alert', size: 16 }) %></span>
              <span><%= label %></span>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>

    <% if (call.transcript) { %>
      <div class="card">
        <h2>Transcript</h2>
        <pre class="pre-box transcript"><%= call.transcript %></pre>
      </div>
    <% } %>
  </main>
</body>
</html>
