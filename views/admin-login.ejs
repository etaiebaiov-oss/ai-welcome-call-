<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>Sign in · <%= companyName %></title>
</head>
<body>
  <main class="auth-page">
    <div class="card auth-card">
      <div class="auth-brand">
        <%- include('partials/logo', { size: 40 }) %>
        <div>
          <h1><%= companyName %></h1>
          <span class="role-badge">Admin</span>
        </div>
      </div>
      <p class="muted" style="margin-top:0">Sign in to review welcome calls, recordings, and flags.</p>
      <% if (error) { %>
        <div class="alert alert-error"><%- include('partials/icon', { name: 'alert', size: 16 }) %><div><%= error %></div></div>
      <% } %>
      <form method="post" action="/admin/login" class="stack">
        <label>Password
          <input type="password" name="password" required autofocus autocomplete="current-password">
        </label>
        <button class="btn btn-primary" type="submit">Sign in</button>
      </form>
    </div>
  </main>
</body>
</html>
