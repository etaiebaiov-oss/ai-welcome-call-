<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>Call Script · <%= companyName %></title>
</head>
<body>
  <%- include('partials/adminnav') %>

  <main class="wide">
    <div class="page-head">
      <div>
        <h1>Call Scripts</h1>
        <p>One script per account. Each has its own wording, its own running order, and its own voice. Changes sync to the voice assistant when you save.</p>
      </div>
    </div>
    <div class="card">
      <div class="filter-tabs" style="margin:2px 0 16px">
        <% Object.keys(variants).forEach((key) => { %>
          <a class="btn btn-sm filter-btn <%= variant === key ? 'active' : '' %>" href="/admin/script?variant=<%= key %>"><%= variants[key].label %></a>
        <% }) %>
      </div>
      <p class="muted">
        You're editing the <strong><%= variants[variant].label %></strong> script — used by every welcome call created
        for that account, and spoken in that account's own voice.
        You can use these placeholders anywhere and they'll be filled in per homeowner:
        <code>{{homeownerName}}</code> <code>{{propertyAddress}}</code> <code>{{phoneNumber}}</code>
        <code>{{companyName}}</code> <code>{{monthlyPayment}}</code> <code>{{escalator}}</code> <code>{{offsetPercent}}</code>
        <br><span class="muted">{{companyName}} is the installer running the call — Southwest Solar — no matter which sales partner sold the job.</span>
      </p>
      <% if (saved) { %><div class="alert alert-success">Script saved and synced to the voice assistant.</div><% } %>
      <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
      <form method="post" action="/admin/script" class="stack">
        <input type="hidden" name="variant" value="<%= variant %>">
        <textarea name="script" rows="28" class="code-area"><%= script %></textarea>
        <div class="btn-row">
          <button class="btn btn-primary" type="submit">Save &amp; sync script</button>
          <button class="btn btn-ghost" type="button" id="reset-btn">Reset to default</button>
        </div>
      </form>
      <script>
        const DEFAULT_SCRIPT = <%- JSON.stringify(defaultScript).replace(/</g, '\\u003c') %>;
        document.getElementById('reset-btn').addEventListener('click', () => {
          if (confirm('Reset the <%= variants[variant].label %> script to its default?')) {
            document.querySelector('.code-area').value = DEFAULT_SCRIPT;
          }
        });
      </script>
    </div>
  </main>
</body>
</html>
