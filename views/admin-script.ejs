<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>Call Scripts · Welcome Call Center</title>
</head>
<body>
  <%- include('partials/adminnav') %>

  <main class="wide">
    <div class="page-head">
      <div>
        <h1>Call Scripts</h1>
        <p>The scripts the AI follows on every welcome call — one per installer brand. Changes sync to the voice assistant when you save.</p>
      </div>
    </div>
    <div class="card">
      <div class="filter-tabs" style="margin:10px 0 14px">
        <a class="btn btn-sm filter-btn <%= variant === 'sw' ? 'active' : '' %>" href="/admin/script?variant=sw">Southwest Solar (SW)</a>
        <a class="btn btn-sm filter-btn <%= variant === 'pss' ? 'active' : '' %>" href="/admin/script?variant=pss">Pacific Sky (PSS)</a>
      </div>
      <% if (variant === 'pss') { %>
        <p class="muted">Editing the <strong>Pacific Sky (PSS)</strong> script — used for calls marked PSS. Until you save a PSS version, PSS calls fall back to the SW script.</p>
      <% } %>
      <p class="muted">
        This is the script the AI follows on every welcome call. Edit it to match your exact wording —
        changes sync to the voice assistant automatically when you save.
        You can use these placeholders anywhere and they'll be filled in per homeowner:
        <code>{{homeownerName}}</code> <code>{{propertyAddress}}</code> <code>{{phoneNumber}}</code>
        <code>{{companyName}}</code> <code>{{monthlyPayment}}</code> <code>{{escalator}}</code> <code>{{offsetPercent}}</code>
        <br><span class="muted">{{companyName}} is the installer entered on the call form (falls back to the site's COMPANY_NAME setting).</span>
      </p>
      <% if (saved) { %><div class="alert alert-success">Script saved and synced to the voice assistant.</div><% } %>
      <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
      <form method="post" action="/admin/script" class="stack">
        <input type="hidden" name="variant" value="<%= variant %>">
        <textarea name="script" rows="28" class="code-area"><%= script %></textarea>
        <div class="btn-row">
          <button class="btn btn-primary" type="submit">Save &amp; sync script</button>
          <button class="btn btn-ghost" type="button" id="reset-btn">Reset to default</button>
        </div>
      </form>
      <script>
        const DEFAULT_SCRIPT = <%- JSON.stringify(defaultScript).replace(/</g, '\\u003c') %>;
        document.getElementById('reset-btn').addEventListener('click', () => {
          if (confirm('Reset to the default script?')) {
            document.querySelector('.code-area').value = DEFAULT_SCRIPT;
          }
        });
      </script>
    </div>
  </main>
</body>
</html>
