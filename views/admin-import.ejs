<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>Import · <%= companyName %></title>
</head>
<body>
  <%- include('partials/adminnav') %>

  <main class="wide">
    <div class="page-head">
      <div>
        <h1>Import</h1>
        <p>Turn your deal board into welcome-call links in one upload. Re-uploading an updated board is safe — existing clients are skipped.</p>
      </div>
    </div>
    <div class="card">
      <h2>Upload your deal board</h2>
      <p class="muted">
        Upload your deal board (.xlsx or .csv). Each row with a homeowner name, address, and phone becomes a
        welcome-call link, with the installer, energy offset, and all deal details (stage, NTP status, panels,
        site survey, notes) attached. Homeowners with a <strong>change order</strong> are flagged automatically.
        Rows whose phone number already has a call on file are skipped, so re-uploading an updated board is safe.
      </p>
      <% if (error) { %><div class="alert alert-error"><%- include('partials/icon', { name: 'alert', size: 16 }) %><div><%= error %></div></div><% } %>
      <form method="post" action="/admin/import" enctype="multipart/form-data" class="stack">
        <label>Spreadsheet file
          <input type="file" name="file" accept=".xlsx,.xls,.csv" required>
        </label>
        <button class="btn btn-primary" type="submit"><%- include('partials/icon', { name: 'upload', size: 15 }) %> Import &amp; create call links</button>
      </form>
    </div>

    <% if (result) { %>
      <div class="card">
        <h2>Import complete</h2>
        <div class="stats-row">
          <div class="stat stat-success">
            <span class="stat-icon"><%- include('partials/icon', { name: 'check-circle', size: 18 }) %></span>
            <div><span class="stat-label">Call links created</span><span class="stat-num ok"><%= result.created.length %></span></div>
          </div>
          <div class="stat stat-warn">
            <span class="stat-icon"><%- include('partials/icon', { name: 'edit', size: 18 }) %></span>
            <div><span class="stat-label">With change orders</span><span class="stat-num warn"><%= result.changeOrders %></span></div>
          </div>
          <div class="stat">
            <span class="stat-icon"><%- include('partials/icon', { name: 'clock', size: 18 }) %></span>
            <div><span class="stat-label">Skipped (already have a call)</span><span class="stat-num"><%= result.skippedExisting %></span></div>
          </div>
          <div class="stat">
            <span class="stat-icon"><%- include('partials/icon', { name: 'alert', size: 18 }) %></span>
            <div><span class="stat-label">Skipped (missing/bad contact)</span><span class="stat-num"><%= result.missingContact + result.badPhone %></span></div>
          </div>
        </div>

        <% if (result.created.length) { %>
          <h3>Share links — copy all as CSV (paste into Sheets/Excel to text or email them out)</h3>
          <textarea class="code-area" rows="8" readonly onclick="this.select()"><%= 'Name,Phone,Email,Change Order,Link\n' + result.created.map(c => [c.name, c.phone, c.email, c.changeOrder ? 'YES' : '', c.link].join(',')).join('\n') %></textarea>
          <div class="table-scroll" style="margin-top:16px">
            <table>
              <thead><tr><th>Homeowner</th><th>Phone</th><th></th><th>Link</th></tr></thead>
              <tbody>
                <% result.created.forEach((c) => { %>
                  <tr>
                    <td><strong><%= c.name %></strong></td>
                    <td><%= c.phone %></td>
                    <td><% if (c.changeOrder) { %><span class="badge badge-warn"><%- include('partials/icon', { name: 'edit', size: 12 }) %> Change order</span><% } %></td>
                    <td><a class="link-trunc" href="<%= c.link %>" target="_blank"><%= c.link %></a></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
        <p style="margin-top:14px"><a class="btn btn-primary" href="/admin">Go to dashboard →</a></p>
      </div>
    <% } %>

    <% if (imported && imported.length) { %>
      <div class="card">
        <h2>All imported clients <span class="muted" style="font-weight:normal;font-size:0.8em">(saved — every import lives here)</span></h2>
        <h3>Copy all as CSV</h3>
        <textarea class="code-area" rows="6" readonly onclick="this.select()"><%= 'Name,Phone,Email,Status,Change Order,Link\n' + imported.map(c => [c.homeowner_name, c.phone, c.email || '', c.status, c.changeOrder ? 'YES' : '', c.link].join(',')).join('\n') %></textarea>
        <div class="table-scroll" style="margin-top:16px">
          <table>
            <thead><tr><th>Homeowner</th><th>Phone</th><th>Status</th><th></th><th>Link</th><th></th></tr></thead>
            <tbody>
              <% imported.forEach((c) => { %>
                <tr>
                  <td><strong><%= c.homeowner_name %></strong></td>
                  <td><%= c.phone %></td>
                  <td>
                    <% if (c.status === 'completed') { %>
                      <span class="badge badge-success"><%- include('partials/icon', { name: 'check', size: 12 }) %> Completed</span>
                    <% } else if (c.status === 'flagged') { %>
                      <span class="badge badge-warn"><%- include('partials/icon', { name: 'alert', size: 12 }) %> Flagged</span>
                    <% } else if (c.status === 'in_progress') { %>
                      <span class="badge badge-info"><%- include('partials/icon', { name: 'phone', size: 12 }) %> In progress</span>
                    <% } else { %>
                      <span class="badge badge-neutral"><%- include('partials/icon', { name: 'clock', size: 12 }) %> Pending</span>
                    <% } %>
                  </td>
                  <td><% if (c.changeOrder) { %><span class="badge badge-warn"><%- include('partials/icon', { name: 'edit', size: 12 }) %> Change order</span><% } %></td>
                  <td><a class="link-trunc" href="<%= c.link %>" target="_blank"><%= c.link %></a></td>
                  <td class="cell-action">
                    <button class="btn btn-sm copy-link" type="button" data-link="<%= c.link %>"><%- include('partials/icon', { name: 'copy', size: 13 }) %> Copy</button>
                    <a class="btn btn-sm" href="/admin/calls/<%= c.id %>">View →</a>
                  </td>
                </tr>
              <% }) %>
              </tbody>
            </table>
          </div>
      </div>
    <% } %>
  </main>

  <script>
    document.querySelectorAll('.copy-link').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const original = btn.innerHTML;
        try {
          await navigator.clipboard.writeText(btn.dataset.link);
        } catch (err) {
          return;
        }
        btn.textContent = 'Copied!';
        setTimeout(() => { btn.innerHTML = original; }, 2000);
      });
    });
  </script>
</body>
</html>
