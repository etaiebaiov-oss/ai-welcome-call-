# ===== Required =====

# From https://dashboard.vapi.ai -> Settings -> API Keys
VAPI_PRIVATE_KEY=your-vapi-private-key
VAPI_PUBLIC_KEY=your-vapi-public-key

# Password for the /admin dashboard
ADMIN_PASSWORD=choose-a-strong-password

# Public URL of this deployment (no trailing slash).
# On Railway: set this AFTER you generate a domain, e.g. https://welcome-calls.up.railway.app
APP_URL=https://your-app.up.railway.app

# ===== Branding =====
# Fallback company the AI speaks for when no installer is entered on the form.
COMPANY_NAME=Your Company
# Accent color for the site (default: friendly light blue)
BRAND_COLOR=#0284c7

# ===== Optional =====

# Where the SQLite DB and downloaded recordings are stored.
# On Railway, attach a Volume and set this to its mount path (e.g. /data)
# so recordings survive redeploys.
DATA_DIR=./data

# To let the AI place OUTBOUND phone calls (instead of the homeowner using the
# web link), buy/import a phone number in Vapi and paste its ID here.
# Leave blank to disable the "Call their phone" button.
VAPI_PHONE_NUMBER_ID=

# Voice used by the assistant. Supported Vapi voices include:
# Savannah, Elliot, Rohan, Leo, Zoe, Mia, Jess, Zac, Dan, Leah, Tara,
# and the newer Emma, Nico, Clara, Layla, Kai...
# (Legacy names like Paige/Kylie are auto-mapped to supported voices.)
VAPI_VOICE_ID=Savannah

# For premium ElevenLabs voices (most natural available):
# 1. Create an account at elevenlabs.io and copy your API key
# 2. Paste the key in the Vapi dashboard: Settings -> Provider Keys -> ElevenLabs
# 3. Set VAPI_VOICE_PROVIDER=11labs and VAPI_VOICE_ID to an ElevenLabs voice ID
#    (e.g. 21m00Tcm4TlvDq8ikWAM = "Rachel", a warm friendly American female)
VAPI_VOICE_PROVIDER=vapi

# Optional overall speaking speed: 1.0 = normal, 0.9 = 10% slower, 1.1 = faster.
# Leave blank for the voice's default pace.
VAPI_VOICE_SPEED=

# The LLM "brain" behind the call. Swap to any model Vapi supports without
# touching code - e.g. the newest OpenAI model, or Anthropic Claude:
#   VAPI_MODEL_PROVIDER=openai    VAPI_MODEL=gpt-4.1        (default)
#   VAPI_MODEL_PROVIDER=anthropic VAPI_MODEL=claude-sonnet-5
VAPI_MODEL_PROVIDER=openai
VAPI_MODEL=gpt-4.1

# Port (Railway sets this automatically)
PORT=3000
